@model InventoryManagement.Models.CustomerViewModel

@{
    ViewData["Title"] = "Edit Customer Details";
}

<link rel="stylesheet" href="~/css/add-customer.css" asp-append-version="true" /> @* Reusing create styles *@

<div class="add-customer-container">
    <div class="page-header-customer">
        <a asp-action="Index" asp-controller="Customer" class="back-link-customer">
            <i class="material-icons">arrow_back</i>
            <span>Back To customer list</span>
        </a>
        <h1 class="page-title-customer">@ViewData["Title"]</h1>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="CustomerId" /> @* Important for POST to identify the customer *@
        <input type="hidden" asp-for="CustomerInfoId" /> @* If you need to track this for updates *@
        <input type="hidden" asp-for="HasExistingPicture" />


        <div class="add-customer-form-layout">
            @* LEFT COLUMN CARD *@
            <div class="form-section-card-customer">
                <div class="customer-image-area">
                    <label for="customerImageUpload" class="customer-image-preview-container">
                        @if (Model.HasExistingPicture)
                        {
                            <img id="customerImagePreview" src="@Url.Action("GetCustomerPicture", "Customer", new { id = Model.CustomerId })" alt="Customer Preview" style="display:block;" />
                            <span id="customerImagePlaceholder" class="customer-image-placeholder" style="display:none;">
                                @(Model.CustomerName?.Substring(0, 1).ToUpper())
                                <span style="font-size: 12px; position: absolute; top: 5px; right: 5px; background-color: rgba(0,0,0,0.5); border-radius: 50%; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center;">+</span>
                            </span>
                        }
                        else
                        {
                            <img id="customerImagePreview" src="#" alt="Customer Preview" style="display:none;" />
                            <span id="customerImagePlaceholder" class="customer-image-placeholder" style="display:flex;">
                                @(string.IsNullOrEmpty(Model.CustomerName) ? "C" : Model.CustomerName.Substring(0, 1).ToUpper())
                                <span style="font-size: 12px; position: absolute; top: 5px; right: 5px; background-color: rgba(0,0,0,0.5); border-radius: 50%; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center;">+</span>
                            </span>
                        }
                    </label>
                    <input asp-for="CustomerPictureFile" type="file" id="customerImageUpload" accept="image/*" />
                    <span asp-validation-for="CustomerPictureFile" class="text-danger"></span>
                </div>

                <div class="form-row-customer">
                    <div class="form-group-customer">
                        <label asp-for="CustomerName">Name</label>
                        <input asp-for="CustomerName" class="form-control" />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>
                    <div class="form-group-customer">
                        <label>Customer ID</label> @* Display only for Edit *@
                        <input class="form-control" value="@(Model.CustomerId == 0 ? "N/A" : "C"+Model.CustomerId.ToString("D3"))" readonly />
                    </div>
                </div>

                <div class="form-row-customer">
                    <div class="form-group-customer">
                        <label asp-for="CustomerType"></label>
                        <select asp-for="CustomerType" class="form-control">
                            <option value="">Select Type...</option>
                            @if (ViewBag.CustomerTypes != null)
                            {
                                foreach (var type in (List<string>)ViewBag.CustomerTypes)
                                {
                                    <option value="@type" selected="@(Model.CustomerType == type)">@type</option>
                                }
                            }
                            else
                            {
                                <option value="Retail" selected="@(Model.CustomerType == "Retail")">Retail</option>
                                <option value="Wholesale" selected="@(Model.CustomerType == "Wholesale")">Wholesale</option>
                            }
                        </select>
                        <span asp-validation-for="CustomerType" class="text-danger"></span>
                    </div>
                    <div class="form-group-customer">
                        <label asp-for="CustomerStatus">Status</label>
                        <select asp-for="CustomerStatus" class="form-control">
                            <option value="">Select Status...</option>
                            @if (ViewBag.CustomerStatuses != null)
                            {
                                foreach (var status in (List<string>)ViewBag.CustomerStatuses)
                                {
                                    <option value="@status" selected="@(Model.CustomerStatus == status)">@status</option>
                                }
                            }
                            else
                            {
                                <option value="Active" selected="@(Model.CustomerStatus == "Active")">Active</option>
                                <option value="Inactive" selected="@(Model.CustomerStatus == "Inactive")">Inactive</option>
                                <option value="Pending" selected="@(Model.CustomerStatus == "Pending")">Pending</option>
                            }
                        </select>
                        <span asp-validation-for="CustomerStatus" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group-customer">
                    <label asp-for="CustomerRemark">Remarks</label>
                    <textarea asp-for="CustomerRemark" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="CustomerRemark" class="text-danger"></span>
                </div>
            </div>

            @* RIGHT COLUMN CARD *@
            <div class="form-section-card-customer">
                <h4>Contact Information</h4>
                <div class="form-row-customer">
                    <div class="form-group-customer">
                        <label asp-for="PhoneNumber">Phone</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group-customer">
                        <label asp-for="CustomerEmail">Email</label>
                        <input asp-for="CustomerEmail" type="email" class="form-control" />
                        <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group-customer">
                    <label asp-for="ShippingAddress">Shipping Address</label>
                    <input asp-for="ShippingAddress" class="form-control" />
                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                </div>
                <div class="form-group-customer">
                    <label asp-for="BillingAddress">Billing Address</label>
                    <input asp-for="BillingAddress" class="form-control" />
                    <span asp-validation-for="BillingAddress" class="text-danger"></span>
                </div>

                <div class="form-actions-customer" style="margin-top: auto;">
                    <a asp-action="Index" asp-controller="Customer" class="btn-customer btn-customer-cancel">Cancel</a>
                    <input type="submit" value="Save Changes" class="btn-customer btn-customer-save" />
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Function to update the image preview
            function updateImagePreview(input) {
                if (input.files && input.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#customerImagePreview').attr('src', e.target.result).show();
                        $('#customerImagePlaceholder').hide();
                        $('input[name="HasExistingPicture"]').val('false'); // Indicate new image uploaded, old one (if any) is to be replaced
                    }
                    reader.readAsDataURL(input.files[0]);
                } else {
                    // If no file is selected (e.g., user cancels dialog),
                    // decide whether to revert to existing image or placeholder
                    if ($('input[name="HasExistingPicture"]').val() === 'true' && "@Url.Action("GetCustomerPicture", "Customer", new { id = Model.CustomerId })" !== "#") {
                         $('#customerImagePreview').attr('src', "@Url.Action("GetCustomerPicture", "Customer", new { id = Model.CustomerId })").show();
                         $('#customerImagePlaceholder').hide();
                    } else {
                        $('#customerImagePreview').hide().attr('src', '#');
                        var customerName = $('#CustomerName').val();
                        var initial = customerName ? customerName.trim().substring(0, 1).toUpperCase() : 'C';
                         $('#customerImagePlaceholder').contents().filter(function() { return this.nodeType === 3; }).first().replaceWith(initial + " ");
                        $('#customerImagePlaceholder').show();
                    }
                }
            }

            $('#customerImageUpload').on('change', function () {
                updateImagePreview(this);
            });

            // Update placeholder initial based on Customer Name input
            $('#CustomerName').on('input', function() {
                var customerName = $(this).val();
                var initial = customerName ? customerName.trim().substring(0, 1).toUpperCase() : 'C';
                // Only update placeholder text if no image is currently displayed by the preview
                if (!$('#customerImagePreview').is(':visible') || $('#customerImagePreview').attr('src') === '#') {
                     $('#customerImagePlaceholder').contents().filter(function() { return this.nodeType === 3; }).first().replaceWith(initial + " ");
                }
            });

            // Trigger file input when the preview area (label) is clicked
            $('.customer-image-preview-container').on('click', function() { // Assuming this class is on the label
                $('#customerImageUpload').click();
            });
        });
    </script>
}