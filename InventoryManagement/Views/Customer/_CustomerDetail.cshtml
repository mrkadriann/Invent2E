@model InventoryManagement.Models.CustomerDetailViewModel

@{
    // Layout = null; // This is a partial view, so no layout
}

<div class="customer-detail-modal-content" style="background-color: var(--dark-bg); color: var(--text-light); border-radius: 12px; border: 1px solid var(--border-color); overflow:hidden;">
    @* HEADER START *@
    <div class="customer-detail-header" style="padding: 15px 25px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="left-actions" style="display: flex; align-items: center;">
            <button type="button" class="btn-icon" data-bs-dismiss="modal" aria-label="Back" style="background-color: transparent; color: var(--text-muted); border: none; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 8px; margin-right: 15px;">
                <i class="material-icons" style="font-size: 24px;">arrow_back</i>
            </button>
        </div>
        <div class="right-actions" style="display: flex; align-items: center; gap: 8px;">
            <a asp-action="Edit" asp-controller="Customer" asp-route-id="@Model.Customer.CustomerId" class="btn" style="background-color: var(--card-bg); color: var(--text-light); border: 1px solid var(--border-color); font-weight: 500; font-size: 0.85rem; padding: 6px 16px; border-radius: 6px;">
               <i class="material-icons" style="font-size:20px;">edit</i>
            </a>
            <a href="#"
               class="btn btn-delete-customer"
               data-customer-id="@Model.Customer.CustomerId"
               data-customer-name="@Model.Customer.CustomerName"
               title="Delete Customer"
               style="background-color: var(--card-bg); color: var(--danger); border: 1px solid var(--border-color); font-weight: 500; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 6px; padding:0;">
                <i class="material-icons" style="font-size:20px;">delete</i>
            </a>
        </div>
    </div>
    @* HEADER END *@

    <div class="modal-body" style="padding: 20px 25px; background-color: var(--dark-bg); max-height: calc(100vh - 160px); overflow-y: auto;">
        <div class="row gx-lg-5 gx-md-4">
            @* Added gx for gutter spacing *@
            @* LEFT COLUMN START *@
            <div class="col-md-7">
                <div style="display: flex; align-items: center; margin-bottom: 25px;">
                    <div class="me-3" style="width: 56px; height: 56px; font-size: 1.8em; background-color: @Model.CustomerAvatarColor; border-radius: 50%; display:flex; align-items:center; justify-content:center; font-weight: 600; color:white; flex-shrink:0;">
                        @if (Model.Customer.CustomerPicture != null && Model.Customer.CustomerPicture.Length > 0)
                        {
                            <img src="@Url.Action("GetCustomerPicture", "Customer", new { id = Model.Customer.CustomerId })"
                                 alt="@Model.Customer.CustomerName Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"
                                 onerror="this.style.display='none'; this.parentElement.querySelector('.customer-avatar-initials-modal').style.display='flex';" />
                            <div class="customer-avatar-initials-modal" style="display:none; width: 100%; height: 100%; font-size: 1.8em; background-color: @Model.CustomerAvatarColor; border-radius: 50%; align-items:center; justify-content:center; font-weight: 600; color:white;">
                                @Model.CustomerAvatarInitial
                            </div>
                        }
                        else
                        {
                            <div class="customer-avatar-initials-modal" style="width: 100%; height: 100%; font-size: 1.8em; background-color: @Model.CustomerAvatarColor; border-radius: 50%; display:flex; align-items:center; justify-content:center; font-weight: 600; color:white;">
                                @Model.CustomerAvatarInitial
                            </div>
                        }
                    </div>
                    <div>
                        <h3 class="mb-0" style="font-size: 1.4rem; font-weight:600; color: var(--text-light);">@Model.Customer.CustomerName</h3>
                        <small style="background-color: rgba(139, 92, 246, 0.15); color: #a78bfa; padding: 3px 8px; border-radius: 10px; font-size: 0.7rem; font-weight: 500;">@Model.Customer.CustomerType</small>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-4" id="customerDetailTab" role="tablist">
                    @* Removed inline style for border-bottom *@
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="cust-general-info-tab" data-bs-toggle="tab" data-bs-target="#cust-general-info" type="button" role="tab" aria-controls="cust-general-info" aria-selected="true">
                            General Information
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="cust-transactions-tab" data-bs-toggle="tab" data-bs-target="#cust-transactions" type="button" role="tab" aria-controls="cust-transactions" aria-selected="false">
                            Transactions
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="cust-history-tab" data-bs-toggle="tab" data-bs-target="#cust-history" type="button" role="tab" aria-controls="cust-history" aria-selected="false">
                            History
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="customerDetailTabContent">
                    <div class="tab-pane fade show active" id="cust-general-info" role="tabpanel" aria-labelledby="cust-general-info-tab">
                        <section class="mb-4">
                            <h5 class="section-title-customer">Customer Details</h5>
                            <div class="info-grid-customer">
                                <div class="info-item-customer"><span class="label">Customer ID</span> <span class="value">@(Model.Customer.CustomerId == 0 ? "N/A" : "C" + Model.Customer.CustomerId.ToString("D3"))</span></div>
                                <div class="info-item-customer"><span class="label">Customer Type</span> <span class="value">@Model.Customer.CustomerType</span></div>
                                <div class="info-item-customer">
                                    <span class="label">Status</span>
                                    <span class="value status-badge-customer status-@(Model.Customer.CustomerStatus?.ToLower())">@Model.Customer.CustomerStatus</span>
                                </div>
                                <div class="info-item-customer"><span class="label">Remark</span> <span class="value remark-value">@(string.IsNullOrWhiteSpace(Model.Customer.CustomerRemark) ? "No remarks added." : Model.Customer.CustomerRemark)</span></div>
                            </div>
                        </section>

                        <section class="mb-4">
                            <h5 class="section-title-customer">Contact Information</h5>
                            <div class="info-grid-customer">
                                <div class="info-item-customer"><span class="label">Phone</span> <span class="value">@Model.Customer.Information?.PhoneNumber</span></div>
                                <div class="info-item-customer"><span class="label">Email</span> <span class="value">@Model.Customer.Information?.CustomerEmail</span></div>
                            </div>
                        </section>

                        <section>
                            <h5 class="section-title-customer">Address</h5>
                            @if (!string.IsNullOrWhiteSpace(Model.Customer.Information?.BillingAddress))
                            {
                                <div class="address-card-customer">
                                    <h6 class="address-type-customer">Billing Address</h6>
                                    <p class="address-text-customer">@Model.Customer.Information.BillingAddress</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Customer.Information?.ShippingAddress))
                            {
                                <div class="address-card-customer">
                                    <h6 class="address-type-customer">Shipping Address</h6>
                                    <p class="address-text-customer">@Model.Customer.Information.ShippingAddress</p>
                                </div>
                            }
                            @if (string.IsNullOrWhiteSpace(Model.Customer.Information?.BillingAddress) && string.IsNullOrWhiteSpace(Model.Customer.Information?.ShippingAddress))
                            {
                                <p style="color: var(--text-muted); font-size: 0.85rem;">No address information available.</p>
                            }
                        </section>
                    </div>

                    <div class="tab-pane fade" id="cust-transactions" role="tabpanel" aria-labelledby="cust-transactions-tab">
                        <h4 style="color: var(--text-muted); text-align:center; padding-top: 50px;">Transactions Content (Blank for now)</h4>
                        @* Transactions content will go here *@
                    </div>

                    <div class="tab-pane fade" id="cust-history" role="tabpanel" aria-labelledby="cust-history-tab">
                        <h4 style="color: var(--text-muted); text-align:center; padding-top: 50px;">History Content (Blank for now)</h4>
                        @* History content will go here *@
                    </div>
                </div>
            </div>
            @* LEFT COLUMN END *@

            @* RIGHT COLUMN START (Current Running Sales Order) *@
            <div class="col-md-5">
                @if (Model.CurrentRunningSaleOrder != null)
                {
                    var saleOrder = Model.CurrentRunningSaleOrder;
                    <div class="running-sale-order-card" style="background-color: var(--card-bg); border-radius: 8px; padding: 20px; border: 1px solid var(--border-color);">
                        <h5 style="font-size: 0.9rem; font-weight: 600; color: var(--text-light); margin-bottom: 15px;">Current Running sales order</h5>

                        <div style="margin-bottom: 15px;">
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 2px;">@saleOrder.OrderId</div>
                            <h6 style="font-size: 1rem; font-weight: 600; color: var(--text-light); margin-bottom: 4px;">@saleOrder.ProductName</h6>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-size: 0.9rem; font-weight: 500; color: var(--text-light);">@saleOrder.Amount.ToString("C", new System.Globalization.CultureInfo("en-PH"))</span>
                                @if (!string.IsNullOrWhiteSpace(saleOrder.Status))
                                {
                                    <span class="badge" style="background-color: @(saleOrder.Status.ToLower() == "unpaid" ? "rgba(167, 139, 250, 0.2)" : "rgba(var(--primary-rgb), 0.2)"); color: @(saleOrder.Status.ToLower() == "unpaid" ? "#a78bfa" : "var(--primary-color)"); font-size: 0.7rem; padding: 3px 8px; font-weight:500; border-radius: 5px;">
                                        @saleOrder.Status
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="order-detail-item-customer">
                            <i class="material-icons">location_on</i>
                            <span>@saleOrder.ShippingTo</span>
                        </div>
                        <div class="order-detail-item-customer">
                            <i class="material-icons">local_shipping</i>
                            <span>@saleOrder.Courier</span>
                        </div>

                        <hr style="border-color: var(--border-color); margin: 15px 0;" />

                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                            <span style="font-size: 0.8rem; color: var(--text-muted);">Status order</span>
                            <span style="font-size: 0.85rem; color: var(--text-light); font-weight: 500;">Next</span> @* Dummy value *@
                        </div>

                        <div style="display: flex; gap: 10px;">
                            <button type="button" class="btn btn-sm flex-grow-1" style="background-color: var(--input-bg); color: var(--text-light); border: 1px solid var(--border-color); font-size: 0.8rem; display:flex; align-items:center; justify-content:center; gap: 5px;">
                                <i class="material-icons" style="font-size: 16px;">add_circle_outline</i> Quote
                            </button>
                            <button type="button" class="btn btn-sm flex-grow-1" style="background-color: var(--input-bg); color: var(--text-light); border: 1px solid var(--border-color); font-size: 0.8rem; display:flex; align-items:center; justify-content:center; gap: 5px;">
                                <i class="material-icons" style="font-size: 16px;">play_circle_outline</i> Started
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center p-4" style="background-color: var(--card-bg); border-radius: 8px; border: 1px solid var(--border-color);">
                        <p style="color: var(--text-muted);">No current running sales order.</p>
                    </div>
                }
            </div>
            @* RIGHT COLUMN END *@
        </div>
    </div>
</div>

