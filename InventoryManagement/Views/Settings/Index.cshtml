@{
    Layout = "_SettingsLayout"; 
}

@model InventoryManagement.Models.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<header class="flex items-center justify-between px-8 py-6">
    <div class="flex items-center space-x-3">
        <img src="images/logo.png"
             alt="invent2E logo"
             class="w-8 h-8" />
        <span class="text-white font-semibold text-lg select-none">invent2E</span>
    </div>
    <div class="text-xs text-[#6B7280] flex items-center space-x-1 cursor-pointer select-none">
        <span>Back</span>
        <i class="fas fa-long-arrow-alt-right"></i>
    </div>
</header>

<main class="flex flex-col items-center px-8">
    <h1 class="text-white font-semibold text-xl mb-1">Settings</h1>
    <p class="text-[#6B7280] text-sm mb-12 max-w-md text-center">
        Manage your account settings and preferences
    </p>

    <form asp-action="Index" method="post" enctype="multipart/form-data" class="w-full max-w-7xl grid grid-cols-12 gap-x-8 gap-y-12">

        <!-- Company Information -->
        <section class="col-span-12 md:col-span-2 space-y-1">
            <h2 class="text-white font-semibold text-sm select-none">Company Information</h2>
            <p class="text-xs leading-tight select-none">Set your company details</p>
        </section>


        <!-- Company Details + Photo Upload -->
        <section class="col-span-12 md:col-span-10 grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="col-span-2 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                    <!-- Existing company fields... -->
                    <div class="flex flex-col">
                        <label asp-for="CompanyName" class="text-xs mb-1 select-none"></label>
                        <input asp-for="CompanyName"
                               class="bg-transparent border border-[#374151] rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#00B66D]" />
                    </div>
                    <div class="flex flex-col">
                        <label asp-for="BusinessType" class="text-xs mb-1 select-none"></label>
                        <input asp-for="BusinessType"
                               class="bg-transparent border border-[#374151] rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#00B66D]" />
                    </div>
                    <div class="flex flex-col">
                        <label asp-for="Phone" class="text-xs mb-1 select-none"></label>
                        <input asp-for="Phone"
                               class="bg-transparent border border-[#374151] rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#00B66D]" />
                    </div>
                    <div class="flex flex-col">
                        <label asp-for="Email" class="text-xs mb-1 select-none"></label>
                        <input asp-for="Email"
                               class="bg-transparent border border-[#374151] rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#00B66D]" />
                    </div>
                    <div class="flex flex-col md:col-span-2">
                        <label asp-for="Address" class="text-xs mb-1 select-none"></label>
                        <input asp-for="Address"
                               class="bg-transparent border border-[#374151] rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#00B66D]" />
                    </div>
                </div>
            </div>

            <!-- Photo Upload Section -->
            <div class="flex flex-col items-center space-y-3">
                <div class="relative group">
                    <img src="@(Model.CurrentPhotoUrl ?? "https://via.placeholder.com/150")"
                         class="w-32 h-32 rounded-full object-cover border-2 border-[#374151]"
                         alt="Company logo">
                </div>
                <div class="flex items-center gap-3">
                    <!-- Edit Photo Button -->
                    <label class="flex items-center cursor-pointer bg-[#374151] hover:bg-[#4B5563] px-3 py-1.5 rounded-md transition">
                        <input asp-for="CompanyPhoto" type="file" class="hidden" />
                        <span class="text-xs text-white">Edit Photo</span>
                    </label>

                    <!-- Delete Button -->
                    <button type="button"
                            class="p-2 text-[#6B7280] hover:text-red-500 hover:bg-red-500/10 rounded-full transition"
                            onclick="resetProfilePhoto()">
                        <i class="fas fa-trash text-sm"></i>
                    </button>
                </div>
            </div>  
        </section>

        <hr class="col-span-12 border-[#374151] my-8" />

        <!-- Preferences -->
        <section class="col-span-12 md:col-span-2 space-y-1">
            <h2 class="text-white font-semibold text-sm select-none">Preferences</h2>
            <p class="text-xs leading-tight select-none">Set your preferences for customized experience</p>
        </section>
        <section class="col-span-12 md:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
            <div class="flex flex-col">
                <label asp-for="Language" class="text-xs mb-1 select-none"></label>
                <select asp-for="Language"
                        class="bg-transparent border border-[#374151] rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#00B66D]">
                    <option value="en">English</option>
                </select>
            </div>
            <div class="flex flex-col">
                <label asp-for="Currency" class="text-xs mb-1 select-none"></label>
                <select asp-for="Currency"
                        class="bg-transparent border border-[#374151] rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#00B66D]">
                    <option value="USD">PHP</option>
                </select>
            </div>
        </section>

        <hr class="col-span-12 border-[#374151] my-8" />

        <!-- Tax Rate -->
        <section class="col-span-12 md:col-span-2 space-y-1">
            <h2 class="text-white font-semibold text-sm select-none">Enable</h2>
            <p class="text-xs leading-tight select-none">Tax Rate (%)</p>
        </section>
        <section class="col-span-12 md:col-span-7 flex items-center space-x-4">
            <div class="flex flex-col w-32">
                <input asp-for="TaxRate"
                       class="bg-transparent border border-[#374151] rounded-md px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-[#00B66D]" />
            </div>
            <div class="flex items-center space-x-2">
                <label class="relative inline-flex items-center cursor-pointer">
                    <input asp-for="EnableTax" class="sr-only peer" />
                    <div class="w-11 h-6 bg-gray-700 rounded-full peer-checked:bg-[#00B66D] transition"></div>
                    <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition peer-checked:translate-x-5"></div>
                </label>
                <span class="text-white text-sm">Enable Tax</span>
            </div>
        </section>

        <hr class="col-span-12 border-[#374151] my-8" />

        <!-- Notifications -->
        <section class="col-span-12 md:col-span-2 space-y-1">
            <h2 class="text-white font-semibold text-sm select-none">Notification</h2>
            <p class="text-xs leading-tight select-none">Choose how you want to receive alerts</p>
        </section>
        <section class="col-span-12 md:col-span-7 space-y-3 max-w-md">
            <div class="flex items-center space-x-2">
                <label class="relative inline-flex items-center cursor-pointer">
                    <input asp-for="NotifyLowStock" class="sr-only peer" />
                    <div class="w-11 h-6 bg-gray-700 rounded-full peer-checked:bg-[#00B66D] transition"></div>
                    <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition peer-checked:translate-x-5"></div>
                </label>
                <span class="text-white text-sm">Notify when the product is LOW in stocks</span>
            </div>
            <div class="flex items-center space-x-2">
                <label class="relative inline-flex items-center cursor-pointer">
                    <input asp-for="NotifyOutOfStock" class="sr-only peer" />
                    <div class="w-11 h-6 bg-gray-700 rounded-full peer-checked:bg-[#00B66D] transition"></div>
                    <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition peer-checked:translate-x-5"></div>
                </label>
                <span class="text-white text-sm">Notify when the product is OUT of stocks</span>
            </div>
            <div class="flex items-center space-x-2">
                <label class="relative inline-flex items-center cursor-pointer">
                    <input asp-for="NotifyReplenish" class="sr-only peer" />
                    <div class="w-11 h-6 bg-gray-700 rounded-full peer-checked:bg-[#00B66D] transition"></div>
                    <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition peer-checked:translate-x-5"></div>
                </label>
                <span class="text-white text-sm">Notify when product needs REPLENISHMENT</span>
            </div>
        </section>


        <div class="col-span-12 mt-12 flex justify-end">
            <button type="submit"
                    class="bg-[#00B66D] text-white py-2 px-8 rounded-md hover:bg-[#009f5d] transition">
                Save Settings
            </button>
        </div>

    </form>
</main>
 